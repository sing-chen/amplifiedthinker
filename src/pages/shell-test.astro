---
// Phase 2 verification page. Its only job is to prove that a page generated from
// `src/` picks up the same nav, fonts, and design tokens as the 16 hand-written
// pages in `public/` — the gate for "the split causes no visual drift".
//
// Deliberately noindex and linked from nowhere. Delete this file once the first
// real Astro surface exists (Phase 8's blog), since that page proves the same thing
// while also being useful.
import BaseLayout from '../layouts/BaseLayout.astro';

const checks = [
  ['Nav', 'Injected by the same nav.js the old pages load. Theme toggle should work.'],
  ['Tokens', 'Colours and type below come from the same styles.css, not a copy.'],
  ['Theme', 'Toggle to dark and reload — no flash of the wrong theme.'],
  ['Base path', 'Assets resolve on both amplifiedthinker.com and the /amplifiedthinker/ GitHub origin.'],
];
---

<BaseLayout
  title="Astro shell test · Amplified Thinker"
  description="Internal Phase 2 verification page."
  noindex={true}
>
  <div style="max-width:var(--page-max);margin:0 auto;padding:56px 40px">
    <p style="font-family:'Poppins',sans-serif;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--fg-brand);margin-bottom:14px">
      Phase 2 · internal
    </p>
    <h1 style="font-family:'Poppins',sans-serif;font-size:var(--fs-h1);font-weight:700;line-height:1.15;letter-spacing:-.02em;margin-bottom:20px">
      The Astro shell renders
    </h1>
    <p style="font-family:'Inter',sans-serif;font-size:var(--fs-body);line-height:1.7;max-width:720px;margin-bottom:32px">
      This page was generated from <code>src/pages/</code>. The 16 existing pages were
      copied from <code>public/</code> untouched. If this looks like the rest of the site,
      the split works.
    </p>

    <dl style="display:grid;gap:18px;max-width:720px">
      {checks.map(([label, detail]) => (
        <div style="border-left:3px solid var(--fg-brand);padding-left:16px">
          <dt style="font-family:'Poppins',sans-serif;font-size:13px;font-weight:600;margin-bottom:4px">{label}</dt>
          <dd style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.65;margin:0;opacity:.85">{detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</BaseLayout>
