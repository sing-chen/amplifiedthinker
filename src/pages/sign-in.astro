---
// The one auth surface: sign in, create an account, request a password reset,
// and set a new one after following the emailed link.
//
// ⚠️ THE TURNSTILE WIDGET LIVES HERE AND NOWHERE ELSE. It is the only page that
// loads challenges.cloudflare.com. In nav.js it would put a third-party request
// on all 16 pages for every guest; scoped here, a network that blocks that host
// costs account creation and nothing else — which matters on a site whose
// audience has already been behind corporate filtering once.
//
// Every <script> carries is:inline. See BaseLayout.astro: bundled as a module,
// nav.js's document.currentScript is null and every nav link breaks.

import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Sign in · Amplified Thinker"
  description="Sign in to keep your learning progress across every device."
  noindex={true}
>
  <link slot="head" rel="stylesheet" href={`${base}/auth-pages.css`} />
  <!--
    ⚠️ is:inline, like every script on this site. Bundled as a module it would
    be deferred behind the Astro graph and its global would not exist when the
    submit handler below looks for it — and the failure would be silent, since
    every caller treats a missing AmplifiedPwned as "check unavailable".
  -->
  <script slot="head" is:inline src={`${base}/pwned.js`}></script>
  <script slot="head" is:inline src={`${base}/auth-pages.js`}></script>
  <!-- The terms/privacy reader modal. Deferred so the dialog markup it binds
       to has been parsed; this page alone loads it — see its header. -->
  <script slot="head" is:inline src={`${base}/auth-doc-modal.js`} defer></script>
  <section class="auth-wrap">

    <!--
      ── A link that no longer works ────────────────────────────────
      Sits ABOVE whichever panel is showing rather than replacing it, because
      the useful next action is always on the form underneath. It is toggled on
      its own and is not part of show().

      ⚠️ Never names a lifetime. Confirmation links last 24 hours and reset
      links one hour, and nothing in the fragment says which kind this was.
    -->
    <div class="auth-panel auth-panel-danger" id="auth-link-dead" hidden>
      <h2 id="auth-link-dead-title">That link no longer works</h2>
      <p class="auth-muted" id="auth-link-dead-why"></p>
      <!--
        Varies with whether there is a session. Signed out, the next action is
        the form underneath. Signed in, there is no next action at all and
        "start again below" would send someone to re-request something they
        already have.
      -->
      <p class="auth-muted" id="auth-link-dead-next">
        Nothing has gone wrong with your account. Start again below and a fresh
        link will be sent.
      </p>
      <div class="auth-actions" id="auth-link-dead-actions" hidden>
        <a class="auth-btn" href="../index.html">Continue to the site</a>
      </div>
    </div>

    <div class="auth-panel" id="auth-loading">
      <p class="auth-muted">Loading&hellip;</p>
    </div>

    <!-- ── Signed out ────────────────────────────────────────────── -->
    <div class="auth-panel" id="auth-form-panel" hidden>
      <h1 id="auth-heading">Sign in</h1>
      <p class="auth-lede" id="auth-lede">
        Your progress follows you to every device you sign in on.
      </p>
      <!--
        ⚠️ MOVED HERE FROM THE SWITCH ROW AT THE FOOT OF THE PANEL, 2026-08-20.
        Down there it sat under "Forgotten your password?", which is where
        someone looks when something has gone wrong — not while they are
        deciding whether to start. The question it answers is prompted by the
        lede directly above it, so it belongs against that.

        Kept as a separate element rather than folded into the lede, because
        setMode() rewrites the lede with textContent and a link inside it would
        be destroyed on the first mode change.
      -->
      <p class="auth-why-line" id="auth-why-line">
        <a class="auth-link" href={`${base}/why-sign-up.html`}>What does an account get me?</a>
      </p>

      <form id="auth-form" novalidate>
        <!--
          Sign-up only. Lands in raw_user_meta_data as `display_name`, which the
          Phase 3 signup trigger already reads into profiles.display_name - so
          this needs no migration. The 60-character cap matches the CHECK
          constraint on that column; longer and the trigger's insert fails
          AFTER the auth user has been created.
        -->
        <div id="auth-name-row" hidden>
          <label class="auth-label-hidden" for="auth-name">First name</label>
          <div class="auth-field">
            <span class="auth-field-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
            <input type="text" id="auth-name" autocomplete="given-name" maxlength="60"
                   placeholder="First name &mdash; so emails greet you" />
          </div>
        </div>

        <label class="auth-label-hidden" for="auth-email">Email</label>
        <div class="auth-field">
          <span class="auth-field-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg></span>
          <input type="email" id="auth-email" autocomplete="username" required
                 placeholder="Email &mdash; confirmations and resets" />
        </div>
        <!--
          ⚠️ THIS LINE IS GONE, AND ITS CONTENT IS IN THE FIELD'S PLACEHOLDER.
          It read "Sign-up confirmation and password resets. Anything else is
          opt-in." The first half is now "Email — confirmations and resets"; the
          second half is carried by the tickbox below it, which says what the
          only other message is and that it is off unless you ask.

          The history below is kept because the line has been wrong once before
          and the reasoning is what stops it going wrong again.

          It sat under the EMAIL field, not the name field, because that is what
          it is a promise about.

          ⚠️ THIS LINE WENT FROM TRUE TO FALSE ON 2026-08-20 and had to be
          rewritten. It used to read "Sign-up confirmation and password resets.
          Never a newsletter." — accurate right up until the account started
          offering update email, at which point the reassurance became a lie
          told at the exact moment someone is deciding whether to trust us.

          The negative half is still the load-bearing half: asking for a name
          and an address reads as the first step of a mailing list unless
          something says otherwise. What changed is that the answer is now
          "only if you tick the box" rather than "never".

          ⚠️ Update this whenever what the account sends changes, and change
          privacy.html §8 in the same commit.
        -->
        <div id="auth-password-row">
          <label class="auth-label-hidden" for="auth-password">Password</label>
          <div class="auth-field">
            <span class="auth-field-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
            <div class="auth-pw">
              <input type="password" id="auth-password" autocomplete="current-password"
                     required minlength="8" placeholder="Password &mdash; 8+ characters" />
              <button type="button" class="auth-pw-toggle" data-pw-for="auth-password"
                      aria-pressed="false" aria-label="Show password">Show</button>
            </div>
          </div>
          <!--
            ⚠️ THE HINT ELEMENT IS GONE, NOT EMPTIED. The placeholder carries the
            length rule, and the breach check now explains itself in its own
            rejection — see message() in public/pwned.js for why that is the
            right place for it. Nothing is left for a standing hint to say here.
            setMode() no longer toggles anything for this field.
          -->
        </div>

        <!--
          ── Consent to site-update email ────────────────────────────────
          ⚠️ THE ONE TICKBOX ON THIS FORM, AND IT REVERSES AN EARLIER ARGUMENT
          ON PURPOSE. The terms and privacy links below the button carry a
          comment saying no consent checkbox belongs here, because "nothing here
          is optional processing". That was right, and this is the exception it
          implies: update email IS optional processing, so it is the one thing
          that genuinely needs an affirmative act.

          Four properties, none of them cosmetic — this is what makes the
          consent valid under Article 7 and PECR reg 22:

            1. UNTICKED, and never pre-ticked. A pre-ticked box is not consent.
               There is no `checked` attribute here and none may be added.
            2. Separate from the terms line. Bundling consent into "by signing
               up you agree…" makes it a condition of the service, which is
               exactly what Article 7(4) says it must not be.
            3. Specific about what arrives, so the reader knows what they are
               agreeing to rather than agreeing to "updates".
            4. Refusable at no cost — the account works identically either way.

          ⚠️ TWO THINGS CHANGED HERE ON 2026-08-27 AND BOTH ARE WORTH KNOWING.

          The hint under this box was removed and its content redistributed,
          not dropped. It read "Occasional, about this site only, and you can
          stop it at any time from your account."

          ⚠️ "YOU CAN STOP ANY TIME" IS IN THE LABEL BECAUSE ARTICLE 7(3)
          REQUIRES IT THERE. The right to withdraw must be made known BEFORE
          consent is given, and the label is the only text a person is certain
          to read at the moment they tick. Behind a link, or inside the
          collapsed summary below, is later and weaker. Do not move it out to
          shorten this line.

          "Occasional" and "about this site only" are carried by "when a new
          skill or feature lands" — event-driven, and the events are this
          site's own. "Leaving it unticked changes nothing else" moved to the
          email bullet in the summary below: Article 7(4) wants consent not to
          be a condition of service, which the form's structure already shows,
          so it is reassurance rather than an information duty.

          ⚠️ AND "This is not a newsletter" IS A CLAIM ABOUT THE SYSTEM, on a
          form that has already had one such claim go from true to false. It
          said "Never a newsletter" until 2026-08-20, when the account started
          offering update email. This version is narrower and currently true —
          privacy.html §8 and terms.html §2 both describe event-driven,
          opt-in messages rather than a periodical. IT BECOMES FALSE THE DAY A
          ROUNDUP IS SENT. Grep for the promise, not just the feature.

          It is INSIDE the form but outside `auth-name-row`, and toggled by
          setMode() like the other sign-up-only fields. On the sign-in and reset
          forms there is nothing to consent to.
        -->
        <div class="auth-check" id="auth-updates-row" hidden>
          <label class="auth-check-label" for="auth-updates">
            <input type="checkbox" id="auth-updates" />
            <span>Email me when a new skill or feature lands — not a newsletter, and you can stop any time.</span>
          </label>
        </div>

        <div id="auth-turnstile" class="auth-turnstile"></div>
        <p class="auth-hint auth-blocked" id="auth-turnstile-blocked" hidden>
          The security check could not load. It is served by Cloudflare, and some
          workplace networks block it. Signing in and creating an account both
          need it &mdash; try a different network, or <a href="mailto:contact@amplifiedthinker.com">email me</a> and
          I will sort it out directly.
        </p>

        <button type="submit" id="auth-submit">Sign in</button>

        <!--
          ⚠️ Sign-up only, and it sits BELOW the button on purpose.

          This is the moment someone is being asked to hand over a name and an
          address, so the two documents that say what happens to them have to be
          reachable from here — a link on the account page would arrive after
          the decision. Below the button rather than above it because it is a
          reference, not a step: nothing has to be read or ticked to continue.

          No consent checkbox. Nothing here is optional processing, so a tickbox
          would be theatre, and it would put a barrier in front of the one action
          the page exists for.

          ⚠️ These links must not outlive the pages. A dead link here is worse
          than none at all — it appears exactly where someone is deciding whether
          to trust the site. If privacy.html or terms.html is ever renamed, this
          block moves with it.
        -->
        <!--
          ⚠️ THE SPACE BEFORE EACH <a> MUST STAY ON THE SAME LINE AS THE TAG.
          Astro's HTML compressor collapses a newline-plus-indent between a text
          node and an element to NOTHING, not to a single space, so breaking the
          line before <a> shipped "accept the<a>terms of use</a>" — the words run
          together, and it took a screenshot to notice. Keep the space adjacent
          to the tag; do not re-wrap these lines to fit a column width.
        -->
        <p class="auth-hint" id="auth-legal" hidden>
          Creating an account means you accept the <a href={`${base}/terms.html`} data-doc="Terms of use">terms of use</a>.
          What is stored and who handles it is set out in <a href={`${base}/privacy.html`} data-doc="Privacy &amp; cookies">privacy &amp; cookies</a>.
        </p>

        <!--
          ── The short version of both documents ─────────────────────────
          Five points, because someone about to hand over a name and an address
          deserves an answer they can actually finish reading. The two documents
          are 3,200 and 1,250 words; nobody reads either at this moment, and
          pretending otherwise is how "I agree" became meaningless.

          ⚠️ EVERY BULLET IS A SUMMARY OF A REAL SECTION, NOT A REASSURANCE
          WRITTEN TO SOUND GOOD. Each one is checkable against the page it
          points at, and if one stops being true the fix is on both. The
          section numbers are named so the check is one click, not a search.

          A <details>, so it costs nothing when closed and needs no script.
          Toggled with the legal line above: it summarises what you are agreeing
          to, which is only a question on the sign-up form.
        -->
        <details class="auth-summary" id="auth-summary" hidden>
          <summary>
            <svg class="auth-chevron" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            The short version
          </summary>
          <ul>
            <li>Everything on the site is free to read <strong>without an account</strong>. One only remembers where you got to.</li>
            <li>We hold your <strong>first name, your email address, your progress</strong>, and anything you <strong>save or write on the News page</strong>. That is the whole list.</li>
            <li><strong>No cookies at all</strong>, no advertising, no tracking you across the web, and nothing sold or shared.</li>
            <li>Two emails are always sent — <strong>confirmation and password reset</strong>. Anything else is the tickbox above, and leaving it unticked changes nothing else.</li>
            <li>You can <strong>delete your account yourself, immediately</strong>, and no copy is kept.</li>
          </ul>
          <p class="auth-summary-foot">
            Fuller answers: <a href={`${base}/privacy.html#s3`} data-doc="Privacy &amp; cookies">what is collected</a>, <a
            href={`${base}/privacy.html#s8`} data-doc="Privacy &amp; cookies">what email you get</a>, <a
            href={`${base}/privacy.html#s12`} data-doc="Privacy &amp; cookies">your rights</a>.
          </p>
        </details>
      </form>

      <p class="auth-status" id="auth-status" role="status" aria-live="polite"></p>

      <div class="auth-switch">
        <button type="button" class="auth-link" id="auth-to-signup">Create an account</button>
        <button type="button" class="auth-link" id="auth-to-signin" hidden>I already have an account</button>
        <button type="button" class="auth-link" id="auth-to-forgot">Forgotten your password?</button>
      </div>
    </div>

    <!-- ── Setting a new password, after an emailed link ─────────── -->
    <div class="auth-panel" id="auth-recover-panel" hidden>
      <h1>Choose a new password</h1>
      <p class="auth-lede">You followed a reset link, so you can set a new password now.</p>
      <form id="auth-recover-form" novalidate>
        <label class="auth-label-hidden" for="auth-new-password">New password</label>
        <div class="auth-field">
          <span class="auth-field-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
          <div class="auth-pw">
            <input type="password" id="auth-new-password" autocomplete="new-password"
                   required minlength="8" placeholder="New password" />
            <button type="button" class="auth-pw-toggle" data-pw-for="auth-new-password"
                    aria-pressed="false" aria-label="Show password">Show</button>
          </div>
        </div>
        <p class="auth-hint">At least 8 characters.</p>
        <button type="submit" id="auth-recover-submit">Save new password</button>
      </form>
      <p class="auth-status" id="auth-recover-status" role="status" aria-live="polite"></p>
    </div>

    <!--
      ── The password was changed ───────────────────────────────────
      A panel rather than a line of status text, and it REPLACES the form,
      matching what "Account created" does to the sign-up box.

      ⚠️ It exists because the confirmation used to flash past. The old version
      wrote a sentence under the form and redirected 1.4s later, which is long
      enough to notice something happened and not long enough to read what.
      This is the one action on the site with no way to check afterwards
      whether it worked: the account page cannot show you your own password.

      So the redirect stays -- being left on a spent form is its own dead end --
      but it is announced, counted down, and skippable.
    -->
    <div class="auth-panel" id="auth-recover-done" hidden>
      <h1>Password updated</h1>
      <p class="auth-lede" id="auth-recover-done-detail"></p>
      <p class="auth-muted">
        Taking you back to the site<span id="auth-recover-count" aria-hidden="true"></span>.
      </p>
      <div class="auth-actions">
        <!--
          Same relative path as HOME in the script below. Absolute '/index.html'
          would land outside the site on the Pages origin.
        -->
        <a class="auth-btn" href="../index.html">Go there now</a>
      </div>
    </div>

    <!--
      ── Waiting on an email ────────────────────────────────────────
      Signing up and asking for a reset both end here, and it REPLACES the form
      rather than sitting under it. Leaving the email and password fields on
      screen invites a second attempt, which the 60-second per-recipient
      throttle then swallows silently - the second send looks identical to a
      broken one. The only useful next action is in an inbox, so the panel says
      that and offers nothing else.

      The resend button below is the exception, added 2026-08-19 after four dead
      links in one morning of testing. It starts on a countdown, which is what
      makes it safe rather than the same trap with a button on it.
    -->
    <div class="auth-panel" id="auth-sent-panel" hidden>
      <h1 id="auth-sent-heading">Check your email</h1>
      <p class="auth-lede" id="auth-sent-message"></p>
      <p class="auth-muted" id="auth-sent-address"></p>
      <p class="auth-muted">
        It can take a minute to arrive, and it is worth a look in spam.
      </p>

      <!--
        ⚠️ The button starts ALREADY counting down, and that is the whole point
        of having one. An email was just sent to get here, so a pressable button
        guarantees the first press lands inside Supabase's 60-second
        per-recipient throttle — where the send is silently swallowed and looks
        identical to a failure. Counting down visibly says "not yet" instead of
        letting someone discover it.

        This is also why there was no resend button at all until 2026-08-19: the
        objection was right, and the answer was the cooldown rather than
        leaving people stuck.
      -->
      <div class="auth-actions" id="auth-resend-row" hidden>
        <button type="button" class="auth-btn auth-btn-quiet" id="auth-resend" disabled>
          Send it again
        </button>
      </div>
      <p class="auth-status" id="auth-resend-status" role="status" aria-live="polite"></p>
      <!--
        Only shown for sign-up. Someone who leaves now is still a guest, and
        guests no longer get progress saved at all - so browsing on before
        confirming means the next twenty minutes of work is not kept. Better
        said on the button than discovered afterwards.
      -->
      <p class="auth-muted" id="auth-sent-guest-note" hidden>
        You can carry on looking around in the meantime, but until you confirm
        and sign in you are still browsing as a guest &mdash; so nothing you do
        will be saved yet.
      </p>
      <div class="auth-actions">
        <a class="auth-btn auth-btn-quiet" href="../index.html" id="auth-sent-home">Back to the site</a>
      </div>
    </div>

    <!--
      No "you're signed in" panel. A successful sign-in goes straight to the
      home page - the nav avatar is the confirmation, and a page whose only
      content is "that worked" is a step to click through rather than an
      answer. The one exception is the recovery flow below, which needs to show
      that the password actually changed before it moves.
    -->

    <!--
      ── Reading the documents without leaving the form ──────────────────
      Sending someone to privacy.html mid-signup loses the form: they read,
      press Back, and find the fields empty and the captcha token spent. This
      keeps the form exactly where it was.

      ⚠️ A NATIVE <dialog>, WHICH IS THE WHOLE REASON THIS IS ACCEPTABLE HERE.
      account.astro argues against modals — "a focus trap, scroll lock, Escape
      handling, backdrop clicks and focus return; five things to get right". A
      hand-rolled modal still owes all five. `showModal()` gives four of them
      free: focus is trapped, the background goes inert, Escape closes, and
      focus returns to whatever opened it. Only the backdrop click is ours.

      ⚠️ AN IFRAME, NOT A COPY OF THE TEXT. A second copy of a privacy notice is
      a second thing to keep true, and the copy people actually read at the
      moment of signing up would be the one that silently went stale. This is
      the real page, same-origin, so it cannot drift — and `?embed=1` tells it
      to drop its own nav and footer.

      Progressive enhancement: the links keep real href attributes and the
      handler only intercepts where <dialog> is supported. No script, an old
      browser, or a failed load, and it is an ordinary link to a real page.
    -->
    <dialog class="auth-doc-modal" id="auth-doc-modal">
      <div class="auth-doc-head">
        <h2 id="auth-doc-title">Terms of use</h2>
        <div class="auth-doc-actions">
          <a id="auth-doc-tab" href="#" target="_blank" rel="noopener noreferrer">Open in a new tab</a>
          <button type="button" id="auth-doc-close" aria-label="Close">Close</button>
        </div>
      </div>
      <!-- `src` is set on open, so a form that never opens it never fetches a
           3,200-word page. -->
      <iframe id="auth-doc-frame" title="Document" src="about:blank"></iframe>
    </dialog>

  </section>


  <!--
    Turnstile, explicit rendering. It must be explicit rather than automatic
    because the sitekey is not known until supabase-client.js has decided which
    project this origin talks to - dev and prod have different widgets, since a
    Supabase project stores exactly one captcha secret.
  -->
  <script is:inline>
    window.__turnstileReady = false;
    window.onAmplifiedTurnstileLoad = function () {
      window.__turnstileReady = true;
      document.dispatchEvent(new CustomEvent('amplified:turnstile-ready'));
    };
  </script>
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onAmplifiedTurnstileLoad"
    async defer is:inline></script>

  <script is:inline>
    (function () {
      'use strict';

      var el = function (id) { return document.getElementById(id); };

      /* ---- a dead link, read BEFORE anything is awaited -------------------
       *
       * ⚠️ THIS MUST STAY AT THE TOP AND STAY SYNCHRONOUS.
       *
       * A spent or expired link comes back as
       *   #error=access_denied&error_code=otp_expired&error_description=...
       * in the URL FRAGMENT. Not a rejected promise, not an HTTP error — there
       * is nothing to catch anywhere.
       *
       * supabase-js strips the fragment as part of its own async
       * initialisation. Read it after the first await and it is already gone,
       * at which point a dead link is indistinguishable from a working one that
       * quietly did nothing. That is exactly what happened four times in
       * testing on 2026-08-19 before this existed, with the page saying nothing
       * on any of them.
       */
      var linkError = (function () {
        var hash = window.location.hash || '';
        // Only touch it when it is an error. A live link carries the tokens in
        // this same fragment and stripping those would break the sign-in.
        if (hash.indexOf('error') === -1) return null;

        var params;
        try { params = new URLSearchParams(hash.replace(/^#/, '')); }
        catch (e) { return null; }

        var code = params.get('error_code');
        var kind = params.get('error');
        if (!code && !kind) return null;

        // Clear it so a reload does not re-accuse a link the person has since
        // stopped using. history.replaceState leaves no entry behind.
        try {
          window.history.replaceState(null, '',
            window.location.pathname + window.location.search);
        } catch (e) {}

        return { code: code, kind: kind, description: params.get('error_description') };
      })();

      /*
       * Did this page load because someone followed a PASSWORD RESET link?
       *
       * ⚠️ THIS MUST ALSO STAY SYNCHRONOUS, AND FOR A SECOND REASON.
       *
       * Reason one is the same as above: supabase-js strips the fragment during
       * its own async init, so this is unreadable after the first await.
       *
       * Reason two is a race, found on 2026-08-19 by clicking a real reset link.
       * A recovery link DOES establish a session — it has to, since setting a
       * new password requires being authenticated — so the generic "you have a
       * session" path in settle() fires and sends the visitor to the home page.
       * The PASSWORD_RECOVERY listener in start() was supposed to get there
       * first and it cannot: auth.js subscribes during its own init(), before
       * this page subscribes, and supabase-js notifies subscribers in
       * registration order. So settle() ran first, every time, and the whole
       * flow read as "the reset link just logs me in".
       *
       * Registering earlier would only make the race narrower. Reading the
       * intent off the URL removes it: the answer is already in the address bar
       * before any listener exists.
       *
       * ⚠️ Do NOT clear the fragment here, unlike linkError above. The tokens
       * live in this same fragment and supabase-js has not read them yet.
       */
      var arrivedForRecovery = (function () {
        var hash = window.location.hash || '';
        if (hash.indexOf('type=recovery') === -1) return false;
        try {
          return new URLSearchParams(hash.replace(/^#/, '')).get('type') === 'recovery';
        } catch (e) {
          return false;
        }
      })();

      /*
       * ── Surviving a reload ────────────────────────────────────────────────
       *
       * The fragment above is readable EXACTLY ONCE. supabase-js strips it as
       * soon as it has taken the tokens, so a reload of the "Choose a new
       * password" page has no `type=recovery` left to find — while the session
       * IS still there. settle() then takes the ordinary signed-in path and
       * sends the visitor to the home page, password unchanged, with nothing
       * on screen explaining where the form went.
       *
       * ⚠️ There is no way back from that page, which is why this is worth ten
       * lines. The account page can change a password, but since 2026-08-19 it
       * requires the CURRENT one — and not having it is why the person is
       * resetting. So a stray reload costs them the whole round trip: request
       * another email, wait, click again.
       *
       * sessionStorage rather than localStorage, deliberately. The flag has to
       * outlive a reload and must NOT outlive the tab: a later, unrelated visit
       * finding this set would be shown a password form it cannot explain.
       */
      var RECOVERY_KEY = 'amplified_pw_recovery';

      // Belt as well as braces. sessionStorage already dies with the tab, but a
      // tab left open for hours is normal and a recovery that old is not.
      var RECOVERY_TTL_MS = 30 * 60 * 1000;

      function markRecovering() {
        try { window.sessionStorage.setItem(RECOVERY_KEY, String(Date.now())); } catch (e) {}
      }

      function clearRecovering() {
        try { window.sessionStorage.removeItem(RECOVERY_KEY); } catch (e) {}
      }

      function recoveryFlagLive() {
        var raw;
        // Private modes and blocked storage both throw rather than return null.
        try { raw = window.sessionStorage.getItem(RECOVERY_KEY); } catch (e) { return false; }
        if (!raw) return false;

        var at = parseInt(raw, 10);
        if (!at || (Date.now() - at) > RECOVERY_TTL_MS) { clearRecovering(); return false; }
        return true;
      }

      if (arrivedForRecovery) markRecovering();

      function showLinkError(err, session) {
        if (!err) return;

        // ⚠️ GoTrue returns otp_expired for BOTH "already used" and "ran out of
        // time" — the auth logs distinguish them, the fragment does not. So the
        // copy has to cover both without guessing, and without naming a
        // lifetime it cannot know.
        var why = err.code === 'otp_expired'
          ? 'Links can only be used once, and they do not last indefinitely. ' +
            'This one had already been used, or it had run out — including if ' +
            'you opened an older email when a newer one had been sent.'
          : 'The link could not be accepted. It may have been altered in ' +
            'transit, which some corporate mail filters do.';

        el('auth-link-dead-why').textContent = why;

        // Signed in already — which is the common way to arrive here, because
        // the usual cause of a spent link is having successfully used it a
        // moment ago. Telling that person to "start again below" would send
        // them to re-request a confirmation they no longer need.
        if (session) {
          el('auth-link-dead-next').textContent =
            'You are already signed in, so there is nothing you need to do. ' +
            'The link had simply been used — most likely by you, just now.';
          el('auth-link-dead-actions').hidden = false;
        }

        el('auth-link-dead').hidden = false;
      }

      // The password-reveal button and breachedMessage() live in
      // public/auth-pages.js, shared with /account/.
      var breachedMessage = window.AmplifiedAuthPages.breachedMessage;

      var panels = {
        loading: el('auth-loading'),
        form:    el('auth-form-panel'),
        recover: el('auth-recover-panel'),
        done:    el('auth-recover-done'),
        sent:    el('auth-sent-panel')
      };

      // Relative on purpose. This page is served from /sign-in/ on Vercel and
      // from /amplifiedthinker/sign-in/ on GitHub Pages, and '../index.html'
      // is correct under both. An absolute '/index.html' would land outside
      // the site on the Pages origin.
      var HOME = '../index.html';

      /* ── where to go after signing in ───────────────────────────────────
         The nav appends `?next=<path>` so somebody who signs in mid-browse is
         put back where they were rather than dumped on the home page.

         ⚠️ THIS IS AN OPEN REDIRECT IF IT IS WRITTEN AS SANITISATION. `next`
         comes from the URL bar, so it is attacker-controlled by definition: a
         link like /sign-in/?next=https://evil.example genuinely originates from
         this domain, shows this real sign-in form, and then hands the reader
         over the moment they authenticate. That is a phishing primitive, and it
         is the standard way this feature goes wrong.

         So every rule below REJECTS. Nothing is stripped, trimmed, escaped or
         repaired — a value that is not obviously safe is dropped and the reader
         goes to the home page instead. There is no message: a rejected `next`
         is not something a reader did, and explaining it would only teach
         whoever crafted the link which rule they hit.

         The origin comparison is done by the URL parser rather than by pattern
         matching, because the parser is the thing that will eventually resolve
         it. Anything clever enough to fool a regex but not the parser is
         exactly the bug being avoided.
      ─────────────────────────────────────────────────────────────────── */

      // This page is served from <base>/sign-in/ on both origins, so stripping
      // that suffix yields the site's own root — '/' on Vercel,
      // '/amplifiedthinker/' on Pages.
      var SITE_BASE = window.location.pathname.replace(/sign-in\/?$/, '');

      function safeNext() {
        try {
          var raw = new URLSearchParams(window.location.search).get('next');
          if (!raw) return null;

          // Must be a site-absolute path. A scheme, a host, or a relative
          // fragment all fail here rather than being coerced into one.
          if (raw.charAt(0) !== '/') return null;

          // ⚠️ '//evil.example' is a PROTOCOL-RELATIVE URL, not a path. It
          // starts with '/' and is the single most common way this check is
          // written wrong.
          if (raw.charAt(1) === '/') return null;

          // Browsers normalise '\' to '/' inconsistently, so '/\evil.example'
          // can resolve off-origin in some of them.
          if (raw.indexOf('\\') !== -1) return null;

          var url = new URL(raw, window.location.origin);

          // The real check, made by the parser that will do the resolving.
          if (url.origin !== window.location.origin) return null;

          var path = url.pathname + url.search + url.hash;

          // ⚠️ Same-origin is NOT enough on the Pages origin. sing-chen.github.io
          // hosts every one of this account's projects at the same origin, so an
          // origin check alone would happily redirect to a different repository's
          // site. Confine it to this site's own base.
          if (path.indexOf(SITE_BASE) !== 0) return null;

          // Returning to the sign-in page from the sign-in page is a loop.
          if (/\/sign-in\/?$/.test(url.pathname)) return null;

          return path;
        } catch (e) {
          return null;
        }
      }

      // ⚠️ Deliberately NOT used by the email flows. A confirmation or reset
      // link comes back through Supabase's redirect allowlist, and threading a
      // destination through that means widening the allowlist that password
      // resets depend on — for a reader who has already left the page in their
      // mail client. Those keep going to HOME, which is what happens naturally
      // here since the returning URL carries no `next`.
      function returnTarget() {
        return safeNext() || HOME;
      }

      var statusEl = el('auth-status');
      var submitBtn = el('auth-submit');
      // signin | signup | forgot
      //
      // ⚠️ SEEDED FROM THE HASH, so `/sign-in/#sign-up` and `/sign-in/#forgot`
      // open on the right form. Without this the deep links are cosmetic: every
      // one of them lands on the sign-in form and the reader has to find the
      // mode themselves, which is worse than not linking at all — they arrived
      // having already decided.
      //
      // Seeding the variable rather than calling setMode() here is deliberate.
      // settle() does `setMode(mode)` the moment it shows the form, and that is
      // the call that keeps every hidden/required pair in step. Calling setMode
      // now would run it twice; setting `mode` and never calling it at all would
      // paint a form whose `required` attributes silently disagree with it.
      //
      // Exact matches only. A real recovery link arrives as
      // `#access_token=…&type=recovery`, and a substring test would be one
      // rename away from mistaking one for the other.
      var mode = (function () {
        var hash = window.location.hash;
        if (hash === '#sign-up') return 'signup';
        if (hash === '#forgot') return 'forgot';
        return 'signin';
      })();

      function show(name) {
        Object.keys(panels).forEach(function (k) {
          panels[k].hidden = (k !== name);
        });
      }

      function setStatus(text, kind) {
        statusEl.textContent = text || '';
        statusEl.className = 'auth-status' + (kind ? ' ' + kind : '');
      }

      // A validation message names a FIELD as well as a problem: the input is
      // marked invalid, described by the status line, and given focus, so a
      // screen-reader user hears which box to fix rather than only that one
      // exists. Cleared on the next attempt so a corrected field is not still
      // announced as wrong.
      function fieldError(id, text) {
        clearFieldErrors();
        var input = el(id);
        setStatus(text, 'bad');
        if (!input) return;
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', 'auth-status');
        try { input.focus({ preventScroll: false }); } catch (e) { input.focus(); }
      }
      function clearFieldErrors() {
        ['auth-name', 'auth-email', 'auth-password'].forEach(function (id) {
          var input = el(id);
          if (!input) return;
          input.removeAttribute('aria-invalid');
          input.removeAttribute('aria-describedby');
        });
      }

      /* ---- resending a confirmation --------------------------------------
       *
       * ⚠️ /auth/v1/resend is captcha-protected, confirmed from the auth logs
       * on 2026-08-19: a call without a token comes back
       * `400 captcha_failed — no captcha_token found`. It needs the same fresh
       * Turnstile token as signup and sign-in.
       */
      var RESEND_COOLDOWN = 60;
      var resendEmail = null;
      var resendTimer = null;

      function startCooldown(seconds) {
        var left = seconds;
        var btn = el('auth-resend');

        function tick() {
          if (left <= 0) {
            btn.disabled = false;
            btn.textContent = 'Send it again';
            resendTimer = null;
            return;
          }
          btn.disabled = true;
          btn.textContent = 'Send it again in ' + left + 's';
          left--;
          resendTimer = setTimeout(tick, 1000);
        }

        if (resendTimer) clearTimeout(resendTimer);
        tick();
      }

      el('auth-resend').addEventListener('click', function () {
        var auth = window.AmplifiedAuth;
        var out = el('auth-resend-status');
        if (!auth || !resendEmail) return;

        el('auth-resend').disabled = true;
        out.textContent = 'Sending...';
        out.className = 'auth-status';

        freshToken().then(function (token) {
          if (!token) {
            out.textContent = 'The security check did not complete. Try again in a moment.';
            out.className = 'auth-status bad';
            el('auth-resend').disabled = false;
            return null;
          }
          return auth.client().auth.resend({
            type: 'signup',
            email: resendEmail,
            options: { emailRedirectTo: auth.selfUrl(), captchaToken: token }
          });
        }).then(function (r) {
          if (!r) return;
          if (r.error) {
            out.textContent = r.error.message;
            out.className = 'auth-status bad';
            el('auth-resend').disabled = false;
            return;
          }
          out.textContent = 'Sent. Use the newest email — older links stop working.';
          out.className = 'auth-status good';
          startCooldown(RESEND_COOLDOWN);
        });
      });

      // Swaps the whole form out for "go and look in your inbox". `waiting` is
      // then permanent for this page load: there is no session coming, so
      // nothing else will move the panel on, and the form must not reappear.
      var waiting = false;

      // `offerResend` is false for a password reset: resend({type:'signup'})
      // would be the wrong call, and someone who already has an account can
      // simply ask for another reset from the form.
      function showSent(heading, message, address, asGuest, offerResend, cooldown) {
        waiting = true;
        el('auth-sent-heading').textContent = heading;
        el('auth-sent-message').textContent = message;
        el('auth-sent-address').textContent = 'Sent to ' + address + '.';

        resendEmail = offerResend ? address : null;
        el('auth-resend-row').hidden = !offerResend;
        el('auth-resend-status').textContent = '';
        if (offerResend) startCooldown(cooldown);
        // Only after sign-up. Someone resetting a password already has an
        // account, so telling them they are a guest would just be wrong.
        el('auth-sent-guest-note').hidden = !asGuest;
        el('auth-sent-home').textContent = asGuest
          ? 'Keep looking around as a guest'
          : 'Back to the site';
        setStatus('');
        show('sent');
      }

      // ---- Turnstile ------------------------------------------------------
      //
      // The widget — single-use tokens fetched at submit, reset only after a
      // solve, a 30s stall bound — is AmplifiedAuthPages.turnstile(), shared
      // with /account/ since 2026-09-02; the three traps are written up there.
      // Found originally by clicking Create account on a page that had been
      // open a while: the token had aged out.
      var captcha = window.AmplifiedAuthPages.turnstile('#auth-turnstile');
      function renderTurnstile() { captcha.render(); }
      function freshToken() { return captcha.fresh(); }

      document.addEventListener('amplified:turnstile-ready', renderTurnstile);

      // If the script never arrives, say so plainly rather than leaving a
      // button that silently refuses. Corporate networks do block this host.
      setTimeout(function () {
        if (!window.__turnstileReady) el('auth-turnstile-blocked').hidden = false;
      }, 8000);

      // ---- mode -----------------------------------------------------------

      function setMode(next) {
        mode = next;
        setStatus('');
        var isForgot = next === 'forgot';
        var isSignup = next === 'signup';

        el('auth-heading').textContent =
          isForgot ? 'Reset your password' : isSignup ? 'Create an account' : 'Sign in';
        el('auth-lede').textContent =
          isForgot ? 'We will email you a link to set a new one.'
                   : 'Your progress follows you to every device you sign in on.';
        submitBtn.textContent =
          isForgot ? 'Send the reset link' : isSignup ? 'Create account' : 'Sign in';

        el('auth-name-row').hidden = !isSignup;
        el('auth-name').required = isSignup;

        // Sign-up only. On sign-in the person already has an account and knows
        // what it sends; on the reset form the only email in question is the
        // one they just asked for.

        // Sign-up only, and reset to unticked whenever the form changes mode.
        // ⚠️ The reset is the load-bearing half: without it, ticking the box,
        // switching to sign-in and back would leave it ticked from a decision
        // taken about a different form state. Consent has to be the answer to
        // the question actually on screen.
        el('auth-updates-row').hidden = !isSignup;
        if (!isSignup) el('auth-updates').checked = false;

        // Same reasoning, and the same toggle: the terms and privacy links are
        // for the person deciding to create an account, not for someone signing
        // back into one they already agreed to.
        el('auth-legal').hidden = !isSignup;

        // Summarises what you are agreeing to, so it is a question only on the
        // sign-up form. Collapsed again on every mode change: left open, it
        // would reappear expanded on a form where it no longer applies.
        el('auth-summary').hidden = !isSignup;
        if (!isSignup) el('auth-summary').open = false;

        el('auth-password-row').hidden = isForgot;
        el('auth-password').required = !isForgot;
        el('auth-password').autocomplete = isSignup ? 'new-password' : 'current-password';
        // ⚠️ THE PLACEHOLDER IS A RULE FOR CHOOSING A PASSWORD, SO IT ONLY
        // BELONGS WHERE ONE IS BEING CHOSEN. On the sign-in form you are typing
        // a password you already have, and "at least 8 characters" reads either
        // as a demand or as a hint that your existing password might not
        // qualify. Same field, two jobs.
        el('auth-password').placeholder = isSignup
          ? 'Password — 8+ characters'
          : 'Password';

        // ⚠️ SAME ARGUMENT, AND IT IS THE REASON THIS SUFFIX EXISTS AT ALL.
        // "confirmations and resets" is a promise about what will be sent to an
        // address you are handing over, so it belongs at the moment you hand it
        // over and nowhere else. On the sign-in form the account already exists
        // and the mail has already been agreed to; on the reset form the field
        // identifies you rather than collecting anything. In both, the promise
        // is answering a question that was settled at sign-up.
        el('auth-email').placeholder = isSignup
          ? 'Email — confirmations and resets'
          : 'Email';

        el('auth-to-signup').hidden = isSignup;
        el('auth-to-signin').hidden = !isSignup && !isForgot;
        el('auth-to-forgot').hidden = isForgot;

        // Useful while deciding whether to create an account, and while looking
        // at the account you already have. Not while resetting a password —
        // that person is mid-task and has already decided.
        //
        // ⚠️ The WRAPPER is toggled, not the link. The link carries `.auth-link`,
        // whose `[hidden]` override would hide it correctly — but the <p> around
        // it would stay, leaving its margin behind as a gap with nothing in it.
        el('auth-why-line').hidden = isForgot;
      }

      // Reading the terms and the privacy notice without leaving the form is
      // public/auth-doc-modal.js, loaded by this page alone — see its header.

      el('auth-to-signup').addEventListener('click', function () { setMode('signup'); });
      el('auth-to-signin').addEventListener('click', function () { setMode('signin'); });
      el('auth-to-forgot').addEventListener('click', function () { setMode('forgot'); });

      // Seeding `mode` above covers arriving with a hash. It does NOT cover the
      // hash changing on a page that is already open — no reload, so none of
      // the code above runs again, and the form silently keeps its old mode
      // while the address bar claims otherwise.
      //
      // ⚠️ NARROW ON PURPOSE, because the hash is not ours alone. Supabase
      // delivers recovery tokens in it and then clears it, so this fires during
      // the reset flow too. Two guards, both needed:
      //
      //   1. Exact matches only, so a token hash or an emptied hash is ignored.
      //   2. Only while the form panel is the one on screen. Repainting the form
      //      underneath the recovery panel would leave the reader looking at one
      //      thing and submitting another.
      window.addEventListener('hashchange', function () {
        var hash = window.location.hash;
        var next = hash === '#sign-up' ? 'signup' : hash === '#forgot' ? 'forgot' : null;
        if (!next) return;
        if (el('auth-form-panel').hidden) return;
        mode = next;
        setMode(next);
      });

      // ---- submit ---------------------------------------------------------
      // breachedMessage() runs only where a password is CHOSEN — sign-up, and
      // the new password after a reset — never on sign-in. See auth-pages.js.

      el('auth-form').addEventListener('submit', function (e) {
        e.preventDefault();

        var auth = window.AmplifiedAuth;
        if (!auth) { setStatus('Still loading - try again in a moment.', 'bad'); return; }

        var email = el('auth-email').value.trim();
        var password = el('auth-password').value;
        var name = el('auth-name').value.trim();
        // Read at submit rather than held in a variable, so what is sent is
        // exactly what the box showed at the moment the button was pressed.
        var wantsUpdates = el('auth-updates').checked;

        clearFieldErrors();
        if (mode === 'signup' && !name) {
          fieldError('auth-name', 'Enter a first name, so your emails are not addressed to nobody.');
          return;
        }
        if (!email) { fieldError('auth-email', 'Enter your email address.'); return; }
        if (mode !== 'forgot' && password.length < 8) {
          fieldError('auth-password', 'Passwords are at least 8 characters.'); return;
        }
        submitBtn.disabled = true;
        setStatus('Working...');

        // `handled` rather than an early return, because both steps below
        // resolve to null on failure and the chain cannot otherwise tell "the
        // password was refused" from "no captcha token" — it would print the
        // Cloudflare message over the breach explanation.
        var handled = false;

        (mode === 'signup' ? breachedMessage(password) : Promise.resolve(null))
        .then(function (refusal) {
          if (refusal) {
            handled = true;
            submitBtn.disabled = false;
            setStatus(refusal, 'bad');
            return null;
          }
          return freshToken();
        }).then(function (token) {
          if (handled) return null;
          if (!token) {
            submitBtn.disabled = false;
            setStatus(
              'The security check did not complete. Try again — if it keeps ' +
              'failing, your network may be blocking Cloudflare.', 'bad');
            return null;
          }

          return mode === 'forgot' ? auth.resetPassword(email, token)
               : mode === 'signup' ? auth.signUp(email, password, token, name, wantsUpdates)
               :                     auth.signIn(email, password, token);
        }).then(function (r) {
          if (!r) return;
          submitBtn.disabled = false;

          if (r.error) {
            // ⚠️ Not a failure retrying can fix, and the action it calls for —
            // send that link again — is not otherwise on screen. Swap the form
            // for the same panel signup uses, with no cooldown: whatever was
            // sent was sent long enough ago that the throttle has cleared.
            var code = r.error.code || r.error.error_code;
            if (code === 'email_not_confirmed' ||
                /not confirmed/i.test(r.error.message || '')) {
              showSent('Confirm your email first',
                       'This account exists but has not been confirmed yet. ' +
                       'The link was sent when you signed up.',
                       email, true, true, 0);
              return;
            }
            setStatus(r.error.message, 'bad');
            return;
          }

          if (mode === 'forgot') {
            showSent('Check your email',
                     'We have sent a link for setting a new password.',
                     email, false, false, 0);
          } else if (mode === 'signup') {
            // Only when there is no session. If email confirmation is ever
            // switched off, signUp returns one and the account is already
            // usable - telling that person to check their inbox would be a
            // lie, and onAuthChange is about to send them home anyway.
            if (r.data && r.data.session) return;
            showSent('Account created',
                     'Confirm it from the email we have just sent, then sign in.',
                     email, true, true, RESEND_COOLDOWN);
          }
          // Signing in needs no message: onAuthChange redirects to the home page.
        }, function (err) {
          submitBtn.disabled = false;
          setStatus('Something went wrong: ' + err.message, 'bad');
        });
      });

      // ---- setting a new password -----------------------------------------

      // Terminal. Once the password has been changed, nothing may move the page
      // off the confirmation except the countdown or the visitor's own click.
      var finished = false;

      // Seeded from the address bar, or from the flag that survives a reload
      // once the address bar has been emptied. Never from an event — see the
      // comment on arrivedForRecovery for why the event arrives too late.
      var recovering = arrivedForRecovery || recoveryFlagLive();

      el('auth-recover-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var auth = window.AmplifiedAuth;
        var pw = el('auth-new-password').value;
        var out = el('auth-recover-status');

        if (pw.length < 8) {
          out.textContent = 'Passwords are at least 8 characters.';
          out.className = 'auth-status bad';
          return;
        }

        el('auth-recover-submit').disabled = true;
        out.textContent = 'Checking...';
        out.className = 'auth-status';

        breachedMessage(pw).then(function (refusal) {
          if (refusal) {
            el('auth-recover-submit').disabled = false;
            out.textContent = refusal;
            out.className = 'auth-status bad';
            return null;
          }
          return auth.updatePassword(pw);
        }).then(function (r) {
          if (!r) return;
          el('auth-recover-submit').disabled = false;
          if (r.error) {
            out.textContent = r.error.message;
            out.className = 'auth-status bad';
            return;
          }
          recovering = false;
          clearRecovering();
          finished = true;      // ⚠️ BEFORE show('done') — see settle()
          out.textContent = '';

          // Other devices matter MORE here than on the account page. Someone
          // arriving through a reset link is disproportionately someone who
          // thinks another person has their password — so whether the eviction
          // actually happened is worth a sentence rather than a clause.
          el('auth-recover-done-detail').textContent = r.othersSignedOut
            ? 'Your new password is set, and every other device has been signed out. ' +
              'Sign in again with the new password wherever you use the site.'
            : 'Your new password is set. Other devices could not be signed out just ' +
              'now, so anywhere already signed in stays signed in.';

          show('done');
          window.scrollTo(0, 0);
          startRedirect();
        });
      });

      /*
       * Counts down, then goes. The wait is the point: this is the one action
       * on the site with no way to check afterwards whether it worked, since
       * the account page cannot show you your own password.
       *
       * ⚠️ The countdown is aria-hidden and the panel is not a live region. A
       * number changing once a second inside one would be read out six times,
       * which is how a confirmation becomes noise for anyone using a screen
       * reader. The heading and the sentence carry the meaning; the counter
       * only says how long the reader has, and the button beside it means
       * nobody has to wait at all.
       */
      function startRedirect() {
        var left = 6;
        var out = el('auth-recover-count');

        function tick() {
          out.textContent = left > 0 ? ' in ' + left + ' second' + (left === 1 ? '' : 's') : '';
          if (left <= 0) { window.location.replace(HOME); return; }
          left--;
          window.setTimeout(tick, 1000);
        }
        tick();
      }

      // ---- lifecycle -------------------------------------------------------

      function settle(session) {
        // The notice is independent of show() and outlives the panel swap: the
        // explanation still applies whichever form ends up underneath it.
        showLinkError(linkError, session);

        // ⚠️ Gated on the session, and that gate is what makes the flag safe to
        // persist at all. Setting a new password REQUIRES being authenticated,
        // so without a session the recovery panel is a form that cannot work.
        // Signing out is also the clearest possible signal that whatever the
        // flag was for is over — so it is dropped rather than carried.
        if (recovering) {
          if (session) { show('recover'); return; }
          recovering = false;
          clearRecovering();
        }

        // ⚠️ THE FOURTH THING the signed-in redirect below has eaten, and the
        // cause of the confirmation "flashing past" reported on 2026-08-19.
        //
        // updateUser() fires USER_UPDATED. auth.js notifies, settle() runs with
        // a live session and `recovering` already cleared, and the redirect
        // fires IMMEDIATELY — so the 1.4s pause that was supposed to let the
        // confirmation be read never got to run at all. The timer looked like
        // the thing to lengthen, and lengthening it would have changed nothing.
        //
        // Rule for this page, now stated for the fourth time: every state that
        // must be READ has to be checked ahead of that redirect.
        if (finished) return;

        if (waiting) return;          // showing "check your email" — leave it

        // ⚠️ A dead link OUTRANKS the redirect, and this is the second time the
        // signed-in redirect below has quietly eaten something that needed to
        // be read. Found 2026-08-19, following a spent confirmation link while
        // still signed in from having used it: the panel was un-hidden and then
        // destroyed microseconds later by the navigation. The visible result was
        // a dead link that silently worked, which is the worst of both — it
        // teaches people that expired links are fine.
        //
        // Nothing is shown underneath, because there is nothing to offer: the
        // form would invite someone to re-request what they already have.
        if (linkError && session) { show('none'); return; }

        if (session) {
          // Back where they came from, or the home page. `replace` rather than
          // `assign`, so Back does not return here only to bounce forward
          // again — this page has nothing to offer someone already signed in.
          //
          // This also covers arriving with a session already: following the
          // confirmation link from a signup email, or simply opening /sign-in/
          // while signed in. Those carry no `next`, so they land on HOME.
          //
          // ⚠️ Only the DESTINATION changed here. The guards above this line are
          // ordered the way they are because this redirect has quietly eaten
          // four separate states that needed to be read — see the comments on
          // each. Do not reorder them to make room for anything.
          window.location.replace(returnTarget());
        } else {
          show('form');
          setMode(mode);
          renderTurnstile();
        }
      }

      // nav.js calls back when the auth stack it appended has loaded — with
      // null if it never does, in which case the page stays on "Loading…"
      // exactly as its unbounded 60ms poll used to leave it, minus the poll.
      window.AmplifiedNav.whenAuth(start);
      function start(auth) {
        if (!auth) return;

        // A backstop, no longer the mechanism. PASSWORD_RECOVERY does arrive
        // when supabase-js has consumed a reset link, but it arrives too late
        // to be relied on — see arrivedForRecovery, which decides this from the
        // URL before any listener exists. Kept because it costs two lines and
        // covers a shape the fragment cannot: should this project ever move to
        // the PKCE flow, the token comes back as ?code= and there is no
        // type=recovery to read.
        //
        // ⚠️ If that move ever happens, this becomes load-bearing again and the
        // race it lost comes back with it.
        var client = auth.client();
        if (client) {
          client.auth.onAuthStateChange(function (event) {
            if (event === 'PASSWORD_RECOVERY') { recovering = true; show('recover'); }
          });
        }

        auth.onAuthChange(settle);
      }

    })();
  </script>
</BaseLayout>
