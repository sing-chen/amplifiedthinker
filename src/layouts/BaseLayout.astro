---
// Base layout for NEW surfaces only (blog, admin, dashboard). The 16 hand-written
// pages in `public/` do not use this and never will unless one is deliberately
// retrofitted — they ship byte-for-byte untouched.
//
// The head and body structure deliberately mirror `public/index.html` so new pages
// are visually indistinguishable from old ones. Two details carry that:
//
//   1. `nav.js` loads as the first thing in <body>, exactly as the old pages do. It
//      applies the stored theme at the top of its IIFE, so loading it any later
//      reintroduces the flash-of-wrong-theme the old pages avoid.
//   2. Every <script> carries `is:inline`. Astro bundles scripts as scoped ES
//      modules by default, which would break `nav.js`'s global-scope assumptions
//      and any inline handler a page adds.
//
//      `is:inline` is load-bearing for a second, less obvious reason: nav.js
//      derives its link prefix by comparing the page's directory against
//      `document.currentScript.src` (nav.js:37-52). Bundled as a module, that
//      would be `null` and every nav link would resolve from the wrong depth.
//      Verified working at /amplifiedthinker/shell-test/ — nav.js computed `../`
//      correctly, which is also why it already handled the Pages subpath before
//      Astro existed. Do not remove is:inline to "modernise" this.
//
// Asset URLs go through `asset()` rather than a hardcoded leading slash, because
// GitHub Pages serves this site from `/amplifiedthinker/` while Vercel serves from
// `/`. See the `base` note in astro.config.mjs.

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL. Defaults to this page's URL on `site`. */
  canonical?: string;
  ogImage?: string;
  /** Set true for pages that must stay out of search results. */
  noindex?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path}`;

// Canonical must always point at amplifiedthinker.com, including in the GitHub Pages
// build — matching what the 16 existing pages already do. The base prefix has to come
// off the path first, or the Pages build emits `.com/amplifiedthinker/page/`.
const canonicalPath =
  base && Astro.url.pathname.startsWith(base)
    ? Astro.url.pathname.slice(base.length) || '/'
    : Astro.url.pathname;

const {
  title,
  description = '',
  canonical = new URL(canonicalPath, Astro.site).href,
  ogImage = 'https://amplifiedthinker.com/images/og-cover.png',
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" href={asset('images/favicon.png')}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Amplified Thinker">
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500&display=swap&family=Source+Serif+4:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
<link rel="stylesheet" href={asset('styles.css')}>

<!--
  ⚠️ FOOTER STYLING, and it belongs here rather than in styles.css.

  The footer markup below was copied from the hand-written pages; the CSS was
  not, and nobody noticed until /account/ was looked at on production. The 16
  hand-written pages each carry their own copy of these rules INLINE — styles.css
  holds only tokens, the reset and the skip link. So every Astro page rendered a
  bare list of browser-default links, left-aligned, with no dark band.

  Why not simply move it into styles.css, which would de-duplicate all seven
  copies: `footer { … }` is an ELEMENT selector, and search.html has a
  `<footer class="search-footer">` with a different structure and its own rules.
  A shared element selector would restyle a page nobody asked us to touch. That
  de-duplication is a real cleanup, but it needs all 16 pages looked at in one
  pass — logged in BACKLOG.md rather than done in passing here.

  Values are copied verbatim from index.html so the two cannot drift apart
  visually. Only the sticky-footer block below is new.
-->
<style is:inline>
  footer{background:var(--charcoal);padding:32px 40px;border-top:1px solid rgba(255,255,255,.06)}
  .fi{max-width:var(--page-max);margin:0 auto}
  .footer-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
  .footer-tagline{font-family:'Poppins',sans-serif;font-size:12px;font-weight:600;color:rgba(255,255,255,.65);letter-spacing:.02em}
  .footer-nav{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
  .footer-nav a{font-family:'Inter',sans-serif;font-size:12px;color:rgba(255,255,255,.6);text-decoration:none;transition:color .15s}
  .footer-nav a:hover{color:rgba(255,255,255,.85)}
  .footer-nav a:focus-visible{outline:2px solid var(--sage);outline-offset:3px;border-radius:2px}
  .footer-sep{color:rgba(255,255,255,.15);user-select:none}
  .fn{font-family:'Inter',sans-serif;font-size:12px;color:rgba(255,255,255,.55);margin-top:12px}
  @media(max-width:700px){footer{padding-left:20px;padding-right:20px}}

  /* Hold the footer at the bottom of short pages.
     The hand-written pages never needed this — they all have enough content to
     push it down. The auth pages are one small panel, so without it the footer
     sits stranded halfway up the screen with empty space beneath.
     Safe with the fixed nav, which is out of flow and unaffected by this. */
  body{min-height:100vh;min-height:100dvh;display:flex;flex-direction:column}
  main{flex:1 0 auto}
  footer{flex-shrink:0}
</style>

<slot name="head" />
</head>
<body>
<script src={asset('nav.js')} is:inline></script>

<main>
  <slot />
</main>

<footer>
  <div class="fi">
    <div class="footer-inner">
      <p class="footer-tagline">Built for a world that keeps changing.</p>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href={asset('future-skills.html')}>Future Skills</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={asset('my-people.html')}>My People</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={asset('news.html')}>News</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={asset('about.html')}>About</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={asset('about.html#updates')}>What's New</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="https://www.linkedin.com/in/singchen" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </nav>
    </div>
    <div class="fn">© <span id="yr"></span> Sing Chen</div><script is:inline>document.getElementById("yr").textContent=new Date().getFullYear()</script>
  </div>
</footer>
</body>
</html>
