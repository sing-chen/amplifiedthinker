---
// Base layout for NEW surfaces only (blog, admin, dashboard). The 16 hand-written
// pages in `public/` do not use this and never will unless one is deliberately
// retrofitted — they ship byte-for-byte untouched.
//
// The head and body structure deliberately mirror `public/index.html` so new pages
// are visually indistinguishable from old ones. Two details carry that:
//
//   1. `nav.js` loads as the first thing in <body>, exactly as the old pages do. It
//      applies the stored theme at the top of its IIFE, so loading it any later
//      reintroduces the flash-of-wrong-theme the old pages avoid.
//   2. Every <script> carries `is:inline`. Astro bundles scripts as scoped ES
//      modules by default, which would break `nav.js`'s global-scope assumptions
//      and any inline handler a page adds.
//
//      `is:inline` is load-bearing for a second, less obvious reason: nav.js
//      derives its link prefix by comparing the page's directory against
//      `document.currentScript.src` (nav.js:37-52). Bundled as a module, that
//      would be `null` and every nav link would resolve from the wrong depth.
//      First verified on the Pages subpath in Phase 2, where nav.js computed
//      `../` correctly — which is also why it already handled that subpath
//      before Astro existed. Do not remove is:inline to "modernise" this.
//      (The page it was verified on, /shell-test/, was deleted 2026-08-19;
//      /sign-in/ and /account/ exercise the same thing on both origins.)
//
// Asset URLs go through `asset()` rather than a hardcoded leading slash, so this
// layout works at any `base`. GitHub Pages served the site from
// `/amplifiedthinker/` until that origin was retired on 2026-08-26; `base` now
// falls to `/` because nothing sets ASTRO_BASE. The indirection stays —
// unpicking it is a change to live pages with nothing to gain. See the `base`
// note in astro.config.mjs.

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL. Defaults to this page's URL on `site`. */
  canonical?: string;
  ogImage?: string;
  /** `article` for a single dated story; `website` for everything else. */
  ogType?: string;
  /** Set true for pages that must stay out of search results. */
  noindex?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path}`;

// Canonical must always point at amplifiedthinker.com, matching what the
// hand-written pages already do. The base prefix has to come off the path first,
// or a sub-path build emits `.com/amplifiedthinker/page/`. ⚠️ That was the
// GitHub Pages build until 2026-08-26 and there is no sub-path deployment today
// — but the strip is what makes the canonical independent of `base`, so it stays.
const canonicalPath =
  base && Astro.url.pathname.startsWith(base)
    ? Astro.url.pathname.slice(base.length) || '/'
    : Astro.url.pathname;

const {
  title,
  description = '',
  canonical = new URL(canonicalPath, Astro.site).href,
  ogImage = 'https://amplifiedthinker.com/images/og-cover.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" href={asset('images/favicon.png')}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Amplified Thinker">
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
<!-- Every face on the site is Inter, served from our own domain. There is no
     third-party font request left to make, which is why the preconnects to
     fonts.googleapis.com / fonts.gstatic.com are gone rather than commented out. -->
<link rel="preload" href={asset('fonts/inter-var.woff2')} as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href={asset('fonts.css')}>
<link rel="stylesheet" href={asset('styles.css')}>

<!--
  ⚠️ FOOTER STYLING is no longer here. The rules moved to styles.css under
  `.site-footer` (2026-08-21), which is why the <footer> below carries that
  class — the shared block is deliberately NOT a bare `footer` element
  selector, because search.html's `<footer class="search-footer">` is a
  different band and must not be caught by it. Drop the class and this layout
  reproduces the original defect exactly: markup with no styling, a bare list
  of browser-default links with no dark band, and nothing that fails.

  What stays below is only what the Astro pages add on top.
-->
<style is:inline>
  @media(max-width:700px){.site-footer{padding-left:20px;padding-right:20px}}

  /* Hold the footer at the bottom of short pages.
     The hand-written pages never needed this — they all have enough content to
     push it down. The auth pages are one small panel, so without it the footer
     sits stranded halfway up the screen with empty space beneath.
     Safe with the fixed nav, which is out of flow and unaffected by this. */
  body{min-height:100vh;min-height:100dvh;display:flex;flex-direction:column}
  main{flex:1 0 auto}
  .site-footer{flex-shrink:0}
</style>

<slot name="head" />
</head>
<body>
<!-- The skip link and `id="main-content"` mirror the hand-written pages, which
     have carried both since launch; `.skip-link` is already defined in
     styles.css. It was missing here, so the three Astro surfaces made a
     keyboard user tab the whole nav on every page. Added 2026-08-26 with the
     news routes, which is where the gap showed up. -->
<a href="#main-content" class="skip-link">Skip to main content</a>
<script src={asset('nav.js')} is:inline></script>

<main id="main-content">
  <slot />
</main>

<footer class="site-footer">
  <div class="fi">
    <div class="footer-inner">
      <p class="footer-tagline">Built for a world that keeps changing.</p>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href={asset('future-skills.html')}>Future Skills</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={asset('my-people.html')}>My People</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={asset('news/')}>News</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={asset('about.html')}>About</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="https://www.linkedin.com/in/singchen" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </nav>
    </div>
    <div class="fn">© <span id="yr"></span> Sing Chen · <a href={asset('whats-new.html')}>What's New</a> · <a href={asset('why-sign-up.html')}>Why Sign Up</a> · <a href={asset('privacy.html')}>Privacy &amp; Cookies</a> · <a href={asset('terms.html')}>Terms of Use</a></div><script is:inline>document.getElementById("yr").textContent=new Date().getFullYear()</script>
  </div>
</footer>
</body>
</html>
