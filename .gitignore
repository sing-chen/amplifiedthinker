# Claude Code: local machine state stays out, shared command definitions go in.
# `.claude` on its own would exclude the directory outright and git would never
# descend into it, so ignore its contents and re-include what should be tracked.
.claude/*
!.claude/commands/
!.claude/launch.json

# Full-resolution source images. Moved out of `images/` in Phase 2 so they sit
# outside `public/`, which Astro copies into the build verbatim — inside it, a
# local build would have published 6 MB of originals.
_originals/

# Astro / Node
node_modules/
dist/
.astro/

# Local Supabase config. `.env.example` is tracked and holds the shape.
.env
.env.local
.env.*.local

# Supabase CLI local state (linked project ref, local stack volumes). The
# migrations themselves are tracked — they are the schema's source of truth.
supabase/.temp/
supabase/.branches/

# Vercel CLI local state
.vercel/

# The Drive backup folder, if anyone ever points the backup script inside the repo.
amplifiedthinker-backup/

# Fingerprints of what the live origins serve, written by npm run verify:published.
# A point-in-time measurement of production, not source. Regenerate rather than commit.
baseline-*.json
