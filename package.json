{
  "name": "amplified-thinker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/verify-catalogue.mjs && node scripts/verify-signin-return.mjs && node scripts/verify-encoding.mjs",
    "verify:signin-return": "node scripts/verify-signin-return.mjs",
    "verify:encoding": "node scripts/verify-encoding.mjs",
    "fix:encoding": "node scripts/verify-encoding.mjs --fix",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-to-drive.ps1",
    "check:conn": "node scripts/check-connection.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:email": "node scripts/verify-email-dns.mjs",
    "keepalive": "node scripts/keepalive.mjs",
    "verify:redirects": "node scripts/verify-redirects.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "verify:stamp": "node scripts/verify-build-stamp.mjs",
    "build:catalogue": "node scripts/build-skills-catalogue.mjs",
    "verify:catalogue": "node scripts/verify-catalogue.mjs",
    "verify:schema": "node scripts/verify-schema-columns.mjs",
    "verify:completion": "node scripts/verify-completion.mjs",
    "specimen:completion": "node scripts/dev/build-completion-specimen.mjs",
    "specimen:circles": "node scripts/dev/build-circle-specimen.mjs",
    "build:news-seed": "node scripts/build-news-seed.mjs",
    "verify:news-dupes": "node scripts/verify-news-duplicates.mjs",
    "specimen:note-editor": "node scripts/dev/build-note-editor-specimen.mjs",
    "specimen:skill-notes": "node scripts/dev/build-skill-notes-specimen.mjs",
    "specimen:library-notes": "node scripts/dev/build-library-notes-specimen.mjs"
  },
  "devDependencies": {
    "astro": "^7.2.2"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.8"
  }
}
